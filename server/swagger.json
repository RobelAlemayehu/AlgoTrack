{
  "openapi": "3.0.0",
  "info": {
    "title": "AlgoTrack API",
    "version": "1.0.0",
    "description": "API documentation for AlgoTrack - DSA & Competitive Programming Tracker"
  },
  "servers": [
    { "url": "http://localhost:5000", "description": "Local Development Server" }
  ],
  "paths": {
    "/api/auth/register": {
      "post": {
        "summary": "Register a new user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": { "type": "string" },
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "User registered successfully" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Log in user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Logged in successfully" }
        }
      }
    },
    "/api/sync/all": {
      "get": {
        "summary": "Get all user solved problems",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "List of solved problems" }
        }
      }
    },
    "/api/sync/codeforces": {
      "get": {
        "summary": "Sync Codeforces submissions",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Synced Codeforces data" }
        }
      }
    },
    "/api/sync/leetcode": {
      "post": {
        "summary": "Sync LeetCode submissions",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Synced LeetCode data" }
        }
      }
    },
    "/api/review/due": {
      "get": {
        "summary": "Get due spaced-repetition review problems",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "List of due problems" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
